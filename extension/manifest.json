{
  "manifest_version": 3,
  "name": "Getter — Instagram downloads",
  "version": "1.0.0",
  "description": "Save Instagram posts, reels, stories and highlights directly into a folder you choose.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": ["https://www.instagram.com/*", "https://*.cdninstagram.com/*", "https://*.fbcdn.net/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Getter", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{
    "matches": ["https://www.instagram.com/*"],
    "js": ["core.js", "instagram.js", "content.js"],
    "run_at": "document_idle"
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
